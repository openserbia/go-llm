{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": {
    "github:openserbia/go-flake#go_1_27_2": "",
    "github:openserbia/go-flake#golangci-lint_2_14_0": "",
    "github:openserbia/go-flake#govulncheck_1_7_0": "",
    "go-task": "latest",
    "gopls": "latest",
    "delve": "latest",
    "gitleaks": "latest",
